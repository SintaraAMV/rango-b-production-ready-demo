# No subas .env al repositorio.
DATABASE_URL=postgres://teamvault:TU_PASSWORD@localhost:5432/teamvault
SESSION_SECRET=usa-al-menos-32-caracteres-aleatorios-aqui
PORT=3000
NODE_ENV=development

# Producción: obligatorio true. Mantén rejectUnauthorized=true salvo requisito documentado del proveedor.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Opcional: endpoint HTTP que recibe alertas JSON por fallos 5xx/readiness.
ALERT_WEBHOOK_URL=
